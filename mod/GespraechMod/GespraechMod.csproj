<Project Sdk="Microsoft.NET.Sdk">
  <!--
    BepInEx-6-Plugin (IL2CPP) für FM27: Spielergespräche (Lob/Warnung) per Klick aus dem Kaderplaner.
    Bauen:      dotnet build -c Release            (FM27-Ordner über FM27_DIR oder -p:FM27Dir=...)
    Installieren: dotnet build -c Release -p:Installieren=true  (kopiert nach BepInEx\plugins\GespraechMod)
    Referenzen kommen aus dem Spielordner (BepInEx\core, BepInEx\interop) und werden nicht mitkopiert.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>GespraechMod</AssemblyName>
    <RootNamespace>GespraechMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <FM27Dir Condition="'$(FM27Dir)' == '' and '$(FM27_DIR)' != ''">$(FM27_DIR)</FM27Dir>
    <FM27Dir Condition="'$(FM27Dir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Football Manager 27</FM27Dir>
    <BepCore>$(FM27Dir)\BepInEx\core</BepCore>
    <BepInterop>$(FM27Dir)\BepInEx\interop</BepInterop>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepInterop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(BepInterop)\UnityEngine.dll" Private="false" />
    <Reference Include="$(BepInterop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(BepInterop)\UnityEngine.UIElementsModule.dll" Private="false" />
    <Reference Include="$(BepInterop)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(BepInterop)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(BepInterop)\FM.UI.dll" Private="false" />
    <Reference Include="$(BepInterop)\FM.GamePlugin.dll" Private="false" />
    <Reference Include="$(BepInterop)\SI.Core.dll" Private="false" />
    <Reference Include="$(BepInterop)\SI.Interop.dll" Private="false" />
    <Reference Include="$(BepInterop)\SI.Bindable.dll" Private="false" />
    <Reference Include="$(BepInterop)\SI.UI.dll" Private="false" />
  </ItemGroup>

  <Target Name="Installieren" AfterTargets="Build" Condition="'$(Installieren)' == 'true'">
    <!-- Läuft FM27, ist die DLL gesperrt, lässt sich aber umbenennen: neue Version greift beim nächsten Start -->
    <PropertyGroup>
      <Ziel>$(FM27Dir)\BepInEx\plugins\GespraechMod\GespraechMod.dll</Ziel>
    </PropertyGroup>
    <Delete Files="$(Ziel).alt" ContinueOnError="true" />
    <Exec Command="move /Y &quot;$(Ziel)&quot; &quot;$(Ziel).alt&quot; &gt;NUL" Condition="Exists('$(Ziel)') and !Exists('$(Ziel).alt')" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(FM27Dir)\BepInEx\plugins\GespraechMod" />
    <Message Importance="high" Text="Installiert nach $(FM27Dir)\BepInEx\plugins\GespraechMod" />
  </Target>
</Project>
